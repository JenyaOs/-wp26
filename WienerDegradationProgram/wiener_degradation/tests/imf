import numpy as np
from scipy.stats import norm
from wiener_degradation import WienerModel

class Wiener_ConditionIMF:
    """Расчёт условной информационной матрицы Фишера."""

    def __init__(self, model: WienerModel, n, cov, weight, time, z0):
        self.model = model
        self.weight = weight
        self.time = time
        self.z0 = z0
        self.covariates = self._convert_to_array(cov, weight, n)

    def _convert_to_array(self, cov, weight, n):
        array = []
        for i in range(len(cov) - 1):
            for _ in range(int(weight[i] * n)):
                array.append(cov[i])
        while len(array) < n:
            array.append(cov[-1])
        return array[:n]

    def getIMF(self):
        IMF1 = np.array(self.getIMF_part1())
        IMF2 = np.array(self.getIMF_part2())
        return IMF1 - IMF2

    def getIMF_part1(self):
        trend_name = self.model.trend.name
        if trend_name == 'linear':
            return [[self.I11(), self.I12()], [self.I12(), self.I22()]]
        elif trend_name == 'linear_covariate':
            return [[self.I11(), self.I12(), self.I14()], [self.I12(), self.I22(), self.I24()], [self.I14(), self.I24(), self.I44()]]
        elif trend_name == 'power':
            return [[self.I11(), self.I12(), self.I13()], [self.I12(), self.I22(), self.I23()], [self.I13(), self.I23(), self.I33()]]
        elif trend_name == 'power_covariate':
            return [[self.I11(), self.I12(), self.I13(), self.I14()],
                    [self.I12(), self.I22(), self.I23(), self.I24()],
                    [self.I13(), self.I23(), self.I33(), self.I34()],
                    [self.I14(), self.I24(), self.I34(), self.I44()]]

    def getIMF_part2(self):
        trend_name = self.model.trend.name
        if trend_name == 'linear':
            return [[self.I11_F(), self.I12_F()], [self.I12_F(), self.I22_F()]]
        elif trend_name == 'linear_covariate':
            return [[self.I11_F(), self.I12_F(), self.I14_F()], [self.I12_F(), self.I22_F(), self.I24_F()], [self.I14_F(), self.I24_F(), self.I44_F()]]
        elif trend_name == 'power':
            return [[self.I11_F(), self.I12_F(), self.I13_F()], [self.I12_F(), self.I22_F(), self.I23_F()], [self.I13_F(), self.I23_F(), self.I33_F()]]
        elif trend_name == 'power_covariate':
            return [[self.I11_F(), self.I12_F(), self.I13_F(), self.I14_F()],
                    [self.I12_F(), self.I22_F(), self.I23_F(), self.I24_F()],
                    [self.I13_F(), self.I23_F(), self.I33_F(), self.I34_F()],
                    [self.I14_F(), self.I24_F(), self.I34_F(), self.I44_F()]]

    # ================================================================
    # БЕЗУСЛОВНАЯ ЧАСТЬ ИМФ (Part 1) - БЕЗ ИЗМЕНЕНИЙ
    # ================================================================

    def I11(self):
        n = len(self.time)
        x = self.model.x
        return n / np.power(x[0], 2)

    def I12(self):
        return 0.0

    def I13(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            der_ro = self.model.trend.d_func_gamma(self.time[i][-1], x, cov[i])
            if delta_ro != 0:
                s += der_ro / delta_ro
        return s / x[0]

    def I14(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            der_ro = self.model.trend.d_func_beta(self.time[i][-1], x, cov[i])
            if delta_ro != 0:
                s += der_ro / delta_ro
        return s / x[0]

    def I22(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            s += delta_ro
        return s / np.power(x[0], 2)

    def I23(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            der_ro = self.model.trend.d_func_gamma(self.time[i][-1], x, cov[i])
            s += der_ro
        return s * x[1] / np.power(x[0], 2)

    def I24(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            der_ro = self.model.trend.d_func_beta(self.time[i][-1], x, cov[i])
            s += der_ro
        return s * x[1] / np.power(x[0], 2)

    def I33(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            der_ro = self.model.trend.d_func_gamma(self.time[i][-1], x, cov[i])
            if delta_ro != 0:
                s += np.power(der_ro, 2) * (1 / np.power(x[0], 2) + np.power(x[1] / x[0], 2) / delta_ro)
        return s

    def I34(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            der_ro_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov[i])
            der_ro_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov[i])
            if delta_ro != 0:
                s += der_ro_g * der_ro_b * (0.5 / np.power(delta_ro, 2) + np.power(x[1] / x[0], 2) / delta_ro)
        return s

    def I44(self):
        n = len(self.time)
        x = self.model.x
        cov = self.covariates
        s = 0
        for i in range(n):
            delta_ro = self.model.f_ro(self.time[i][-1], cov[i])
            der_ro = self.model.trend.d_func_beta(self.time[i][-1], x, cov[i])
            if delta_ro != 0:
                s += np.power(der_ro, 2) * (0.5 / np.power(delta_ro, 2) + np.power(x[1] / x[0], 2) / delta_ro)
        return s

    # ================================================================
    # УСЛОВНАЯ ЧАСТЬ ИМФ (Part 2) - ИСПРАВЛЕНО С ТОЧНОЙ ФОРМУЛОЙ
    # ================================================================

    def C(self, i):
        """
        C_i = (z0 - μ·ρ(T_i)) / (σ·√ρ(T_i))
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)
        return (self.z0 - x[1] * ro_val) / (x[0] * np.sqrt(ro_val))

    def C2(self, i):
        """
        Вторая компонента для точной формулы: C2_i = (-z0 - μ·ρ(T_i)) / (σ·√ρ(T_i))
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)
        return (-self.z0 - x[1] * ro_val) / (x[0] * np.sqrt(ro_val))

    def F(self, i):
        """
        ТОЧНАЯ функция надёжности (Inverse Gaussian Survival Function):
        R(t) = Φ(C) - exp(2μz/σ²) · Φ(C2)
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)

        c_val = self.C(i)
        c2_val = self.C2(i)

        # Экспоненциальный член
        exp_arg = 2 * x[1] * self.z0 / (x[0]**2)
        if exp_arg > 700:  # Защита от переполнения
            exp_term = np.exp(700)
        else:
            exp_term = np.exp(exp_arg)

        term1 = norm.cdf(c_val)
        term2 = exp_term * norm.cdf(c2_val)

        R = term1 - term2
        return max(float(R), 1e-300)  # Защита от log(0)

    def d_C(self, i, k):
        """
        Первая производная C по параметру θ_k.
        k=0: σ, k=1: μ, k=2: γ, k=3: β
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)

        if k == 0:  # ∂C/∂σ
            return -(self.z0 - x[1] * ro_val) / (x[0]**2 * np.sqrt(ro_val))
        if k == 1:  # ∂C/∂μ
            return -np.sqrt(ro_val) / x[0]
        if k == 2:  # ∂C/∂γ
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            return -der_g * (x[1] * ro_val + self.z0) / (x[0] * 2 * ro_val**1.5)
        if k == 3:  # ∂C/∂β
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            return -der_b * (x[1] * ro_val + self.z0) / (x[0] * 2 * ro_val**1.5)
        return 0.0

    def d_C2(self, i, k):
        """
        Первая производная C2 по параметру θ_k.
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)

        if k == 0:  # ∂C2/∂σ
            return -(-self.z0 - x[1] * ro_val) / (x[0]**2 * np.sqrt(ro_val))
        if k == 1:  # ∂C2/∂μ
            return -np.sqrt(ro_val) / x[0]
        if k == 2:  # ∂C2/∂γ
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            return -der_g * (x[1] * ro_val - self.z0) / (x[0] * 2 * ro_val**1.5)
        if k == 3:  # ∂C2/∂β
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            return -der_b * (x[1] * ro_val - self.z0) / (x[0] * 2 * ro_val**1.5)
        return 0.0

    def d2_C(self, i, k, m):
        """
        Вторая производная C по параметрам θ_k и θ_m.
        """
        x = self.model.x
        cov = self.covariates[i]
        ro_val = self.model.f_ro(self.time[i][-1], cov)

        if (k == 0 and m == 0):
            return 2 * (self.z0 - x[1] * ro_val) / (x[0]**3 * np.sqrt(ro_val))
        if (k == 0 and m == 1) or (k == 1 and m == 0):
            return np.sqrt(ro_val) / x[0]**2
        if (k == 0 and m == 2) or (k == 2 and m == 0):
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            return der_g * (x[1] * ro_val + self.z0) / (2 * x[0]**2 * ro_val**1.5)
        if (k == 0 and m == 3) or (k == 3 and m == 0):
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            return der_b * (x[1] * ro_val + self.z0) / (2 * x[0]**2 * ro_val**1.5)
        if (k == 1 and m == 1):
            return 0.0
        if (k == 1 and m == 2) or (k == 2 and m == 1):
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            return -0.5 * der_g / (x[0] * np.sqrt(ro_val))
        if (k == 1 and m == 3) or (k == 3 and m == 1):
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            return -0.5 * der_b / (x[0] * np.sqrt(ro_val))
        if (k == 2 and m == 2):
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            d2_g = self.model.trend.d2_func_gamma(self.time[i][-1], x, cov)
            s1 = 0.5 * der_g**2 / ro_val**1.5 - d2_g / np.sqrt(ro_val)
            s2 = self.z0 + x[1] * ro_val
            return s1 * s2 / (2 * x[0] * ro_val**1.5)
        if (k == 2 and m == 3) or (k == 3 and m == 2):
            der_g = self.model.trend.d_func_gamma(self.time[i][-1], x, cov)
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            d2_gb = self.model.trend.d2_func_gamma_beta(self.time[i][-1], x, cov)
            s1 = 0.5 * der_g * der_b / ro_val**1.5 - d2_gb / np.sqrt(ro_val)
            s2 = self.z0 + x[1] * ro_val
            return s1 * s2 / (2 * x[0] * ro_val**1.5)
        if (k == 3 and m == 3):
            der_b = self.model.trend.d_func_beta(self.time[i][-1], x, cov)
            d2_b = self.model.trend.d2_func_beta(self.time[i][-1], x, cov)
            s1 = 0.5 * der_b**2 / ro_val**1.5 - d2_b / np.sqrt(ro_val)
            s2 = self.z0 + x[1] * ro_val
            return s1 * s2 / (2 * x[0] * ro_val**1.5)
        return 0.0

    def d_F(self, i, k):
        """
        Первая производная F = R(t) по параметру θ_k.
        """
        x = self.model.x
        c_val = self.C(i)
        c2_val = self.C2(i)

        phi_c = norm.pdf(c_val)
        phi_c2 = norm.pdf(c2_val)

        exp_arg = 2 * x[1] * self.z0 / (x[0]**2)
        if exp_arg > 700:
            exp_term = np.exp(700)
        else:
            exp_term = np.exp(exp_arg)

        # Производная экспоненциального члена
        if k == 0:  # ∂/∂σ
            d_exp = exp_term * (-4 * x[1] * self.z0 / x[0]**3)
        elif k == 1:  # ∂/∂μ
            d_exp = exp_term * (2 * self.z0 / x[0]**2)
        else:
            d_exp = 0.0

        term1 = phi_c * self.d_C(i, k)
        term2 = exp_term * (phi_c2 * self.d_C2(i, k) + c2_val * phi_c2 * d_exp / exp_term if exp_term > 0 else 0)

        return float(term1 - term2)

    def d2_F(self, i, k, m):
        """
        Вторая производная F по параметрам θ_k и θ_m.
        Используется численное дифференцирование для надёжности.
        """
        epsilon = 1e-5
        x_orig = self.model.x.copy()

        # Сохраняем оригинальные значения
        orig_k = x_orig[k]
        orig_m = x_orig[m]

        # Вычисляем вторую производную методом конечных разностей
        x_pp = x_orig.copy(); x_pp[k] += epsilon; x_pp[m] += epsilon
        x_pm = x_orig.copy(); x_pm[k] += epsilon; x_pm[m] -= epsilon
        x_mp = x_orig.copy(); x_mp[k] -= epsilon; x_mp[m] += epsilon
        x_mm = x_orig.copy(); x_mm[k] -= epsilon; x_mm[m] -= epsilon

        self.model.set_params(x_pp)
        f_pp = self.F(i)
        self.model.set_params(x_pm)
        f_pm = self.F(i)
        self.model.set_params(x_mp)
        f_mp = self.F(i)
        self.model.set_params(x_mm)
        f_mm = self.F(i)

        # Восстанавливаем оригинальные параметры
        self.model.set_params(x_orig)

        return (f_pp - f_pm - f_mp + f_mm) / (4 * epsilon**2)

    def d2_lnF(self, k, m):
        """
        Вторая производная log F = log R(t).
        ∂²log F/∂θ_k∂θ_m = Σ_i [∂²F_i/F_i - (∂F_i/∂θ_k)(∂F_i/∂θ_m)/F_i²]
        """
        total = 0.0
        for i in range(len(self.time)):
            f_val = self.F(i)
            if f_val > 1e-300:
                df_k = self.d_F(i, k)
                df_m = self.d_F(i, m)
                d2f = self.d2_F(i, k, m)
                total += d2f / f_val - (df_k * df_m) / (f_val**2)
        return float(total)

    def I11_F(self): return self.d2_lnF(0, 0)
    def I12_F(self): return self.d2_lnF(0, 1)
    def I13_F(self): return self.d2_lnF(0, 2)
    def I14_F(self): return self.d2_lnF(0, 3)
    def I22_F(self): return self.d2_lnF(1, 1)
    def I23_F(self): return self.d2_lnF(1, 2)
    def I24_F(self): return self.d2_lnF(1, 3)
    def I33_F(self): return self.d2_lnF(2, 2)
    def I34_F(self): return self.d2_lnF(2, 3)
    def I44_F(self): return self.d2_lnF(3, 3)